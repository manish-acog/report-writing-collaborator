# Copy to .env and fill in real values. .env is gitignored; this file is not.

# Pick one provider below, via LiteLLM.

# Azure OpenAI (https://docs.litellm.ai/docs/providers/azure).
# AZURE_API_BASE is your resource endpoint, e.g. https://<resource>.openai.azure.com/
# The LiteLLM model string is azure/<deployment-name>, where <deployment-name>
# is the deployment you created in Azure AI Foundry (not the underlying model
# name, e.g. "gpt-4o").
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=

# OR any OpenAI-compatible endpoint, e.g. an internal LiteLLM proxy
# (https://docs.litellm.ai/docs/providers/openai_compatible). The LiteLLM
# model string is openai/<model-name>, matching what the proxy exposes.
OPENAI_API_KEY=
OPENAI_API_BASE=

REPORT_AGENT_MODEL=azure/<deployment-name>

# Optional: a separate LiteLLM model string for inspect_image, if the
# provider above lacks vision support. Defaults to REPORT_AGENT_MODEL.
REPORT_AGENT_VISION_MODEL=

# Required: a published workspace directory, i.e.
# <publish_root>/<workspace_id>/<workspace_version>/ from WorkspaceBuilder.
WORKSPACE_ROOT=
