# Copy to .env and fill in real values. .env is gitignored; this file is not.

# Azure OpenAI credentials, via LiteLLM (https://docs.litellm.ai/docs/providers/azure).
# AZURE_API_BASE is your resource endpoint, e.g. https://<resource>.openai.azure.com/
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=

# Required for Azure: the LiteLLM model string is azure/<deployment-name>,
# where <deployment-name> is the deployment you created in Azure AI Foundry
# (not the underlying model name, e.g. "gpt-4o").
REPORT_AGENT_MODEL=azure/<deployment-name>

# Required: a published workspace directory, i.e.
# <publish_root>/<workspace_id>/<workspace_version>/ from WorkspaceBuilder.
WORKSPACE_ROOT=
