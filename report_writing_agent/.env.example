# Copy to .env and fill in real values. .env is gitignored; this file is not.

# LLM credentials for whichever provider REPORT_AGENT_MODEL points at.
# See https://google.github.io/adk-docs/agents/models/litellm/ for the
# provider-specific environment variable LiteLLM expects.
ANTHROPIC_API_KEY=

# Optional: override the default model (a LiteLLM model string).
# REPORT_AGENT_MODEL=anthropic/claude-sonnet-5

# Required: a published workspace directory, i.e.
# <publish_root>/<workspace_id>/<workspace_version>/ from WorkspaceBuilder.
WORKSPACE_ROOT=
